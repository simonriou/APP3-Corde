                        "classnamespace": "dsp.gen",
                        "rect": [ 59.0, 119.0, 1050.0, 467.0 ],
                        "boxes": [
                            {
                                "box": {
                                    "code": "// Inside [gen~] codebox (1 voice = 1 mode)\nHistory x(0), y(0); // Real (cos) and Imaginary (sin) state states\nParam freq_d(440);\nParam sigma(1.0);\nParam weight(0.0);\nParam ratio(0.0);\n\n// In1 receives a 1-sample impulse (click~) when the string is plucked\ntrig = in1;\n\n// Per-sample rotation and decay coefficients\nomega_step = freq_d * twopi / samplerate;\ndecay = exp(-sigma / samplerate);\nc = decay * cos(omega_step);\ns = decay * sin(omega_step);\n\nif (trig > 0.5) {\n    // Reset initial conditions at t = 0: cos(0) = 1, sin(0) = 0\n    x = 1.0;\n    y = 0.0;\n} else {\n    // Rotate complex phasor and apply exponential decay\n    x_next = x * c - y * s;\n    y_next = x * s + y * c;\n    x = x_next;\n    y = y_next;\n}\n\n// Reconstruct q_n(t) = weight * e^(-sigma*t) * (cos(omega_d*t) + ratio * sin(omega_d*t))\nout1 = weight * (x + ratio * y);",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-5",
                                    "maxclass": "codebox",
                                    "numinlets": 1,
                                    "numoutlets": 1,
                                    "outlettype": [ "" ],
                                    "patching_rect": [ 50.0, 95.0, 741.0, 234.0 ]
                                }
